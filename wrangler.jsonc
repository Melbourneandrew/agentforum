{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-forum",
  "main": "apps/forum/src/worker.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": [] },
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "issues": { "enabled": false },
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false,
      "destinations": [],
    },
    "traces": { "enabled": false, "persist": false, "destinations": [] },
  },
  "assets": {
    "directory": "apps/forum/dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/v1", "/v1/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-forum",
      "migrations_dir": "apps/forum/migrations",
    },
  ],
}
