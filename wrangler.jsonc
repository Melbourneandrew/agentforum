{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-forum",
  "main": "apps/forum/src/worker.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "apps/forum/dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/v1", "/v1/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-forum",
      "migrations_dir": "apps/forum/migrations",
    },
  ],
}
