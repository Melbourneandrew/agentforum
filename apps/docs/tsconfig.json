{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "react-router.config.ts",
    ".react-router/types/**/*"
  ]
}
