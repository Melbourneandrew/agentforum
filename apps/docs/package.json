{
  "name": "@agentforum/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm discovery:prepare && react-router dev --host 0.0.0.0 --port 3001",
    "build": "pnpm discovery:prepare && tsx scripts/prepare-content.ts && react-router build && wrangler deploy --dry-run --outdir dist",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "react-router typegen && tsc --noEmit",
    "effect:check": "tsx ../../scripts/check-effect.ts --project tsconfig.json",
    "test": "vitest run",
    "content:generate": "tsx scripts/prepare-content.ts",
    "bundle:smoke": "tsx scripts/bundle-smoke.ts",
    "discovery:prepare": "tsx scripts/prepare-discovery.ts"
  },
  "dependencies": {
    "effect": "3.22.4",
    "fumadocs-core": "16.17.10",
    "fumadocs-ui": "16.17.10",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "@agentforum/discovery-assets": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@mixedbread/sdk": "0.78.0",
    "@orama/core": "1.2.19",
    "@oramacloud/client": "2.1.4",
    "@react-router/dev": "8.5.1",
    "@react-router/node": "8.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "algoliasearch": "5.61.0",
    "meilisearch": "0.62.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  }
}
