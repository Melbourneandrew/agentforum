{
  "name": "@agentforum/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm discovery:prepare && vite --host 0.0.0.0 --port 3000",
    "build": "pnpm discovery:prepare && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vinext typegen && tsc --noEmit",
    "effect:check": "tsx ../../scripts/check-effect.ts --project tsconfig.json",
    "test": "vitest run",
    "bundle:smoke": "tsx scripts/bundle-smoke.ts",
    "discovery:prepare": "tsx scripts/prepare-discovery.ts"
  },
  "dependencies": {
    "@agentforum/contracts": "workspace:*",
    "@agentforum/discovery-assets": "workspace:*",
    "effect": "3.22.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "vinext": "1.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@next/env": "16.4.4",
    "@types/hast": "3.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  }
}
