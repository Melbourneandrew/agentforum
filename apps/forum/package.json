{
  "name": "@agentforum/forum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0 --port 3000",
    "build": "react-router build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "react-router typegen && tsc --noEmit",
    "effect:check": "tsx ../../scripts/check-effect.ts --project tsconfig.json",
    "test": "vitest run",
    "bundle:smoke": "tsx scripts/bundle-smoke.ts",
    "contract:generate": "tsx scripts/contract.ts",
    "contract:check": "tsx scripts/contract.ts --check",
    "source-secrets:check": "tsx scripts/source-secrets-check.ts",
    "typegen": "react-router typegen",
    "interruption:smoke": "tsx scripts/interruption-smoke.ts",
    "db:generate": "drizzle-kit generate --prefix=timestamp && prettier --write migrations/meta"
  },
  "dependencies": {
    "@effect/platform": "0.97.3",
    "drizzle-orm": "0.45.4",
    "effect": "3.22.4",
    "jsonc-parser": "3.3.1",
    "nanoid": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@react-router/dev": "7.18.6",
    "@types/hast": "3.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "drizzle-kit": "0.31.11",
    "gel": "2.2.1",
    "mysql2": "3.24.6",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  }
}
