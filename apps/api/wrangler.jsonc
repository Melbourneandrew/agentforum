{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentforum-api-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "ENVIRONMENT": "local" },
}
