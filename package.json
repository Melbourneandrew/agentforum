{
  "name": "agentforum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm lint:tooling && turbo run lint",
    "lint:tooling": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm typecheck:tooling && turbo run typecheck",
    "typecheck:tooling": "tsc --noEmit",
    "effect:check": "tsx scripts/check-effect.ts --project tsconfig.json && turbo run effect:check",
    "test": "pnpm test:tooling && turbo run test",
    "test:tooling": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm effect:check && pnpm test",
    "security:check": "pnpm audit --audit-level low",
    "ci:setup": "bash scripts/install-oasdiff.sh",
    "contract:compat": "bash scripts/check-contract-compatibility.sh",
    "dependency:check": "pnpm dedupe --check",
    "discovery:smoke": "tsx scripts/discovery-smoke.ts"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "effect": "3.22.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
